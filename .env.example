# Google OAuth Client ID (Web application, Authorized JavaScript origins must
# include your app's origin, e.g. http://localhost:5173 during dev)
VITE_GOOGLE_CLIENT_ID=

# Backend base URL. Defaults to "/api" when unset, which is the same-origin
# path the Vite dev server proxies to https://cricketapp.in/v1 (see the
# `server.proxy` block in vite.config.js).
#
# All request paths in src/api/ are relative to it (e.g. "/matches" ->
# /api/matches), and a deployed build either keeps a proxied same-origin path
# or sets an absolute origin here. Uploads such as team logos are stored as
# root-relative paths ("/uploads/teams/17.png"); when this value is an
# absolute origin the app re-bases those paths onto it (see
# src/utils/assetUrl.js), and a same-origin setup must proxy "/uploads" the
# same way it proxies "/api".
#
# Do NOT use "https://cricketapp.in/#docs" here; #docs is only the
# documentation fragment and is not an API route.
VITE_API_BASE_URL=